{
  "name": "@buxihuanxibei/dsh-daily-log",
  "version": "1.4.5",
  "type": "module",
  "description": "左侧工作栏里的工作日志面板：写当日总结、维护带编号的任务，一键把任务发到指定工作区的「新会话」或「已有对话」直接开始/继续干活，并按真实 token 用量粗略估算当日花费与每个任务的花费。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "work-log",
    "daily-log",
    "task",
    "cost"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "author": "西北",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/buxihuanxibei/dsh-workbench.git"
  }
}
